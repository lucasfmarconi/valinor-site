---
import type { Dict } from '../i18n';
interface Props { t: Dict }
const { t } = Astro.props;
---

<section id="contact" aria-label={t.contact.heading}>
  <div class="container">
    <h2>{t.contact.heading}</h2>
    <p class="muted intro">{t.contact.body}</p>
    <form name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field">
      <input type="hidden" name="form-name" value="contact" />
      <p class="hidden" aria-hidden="true">
        <label>Don't fill this out: <input name="bot-field" /></label>
      </p>
      <div class="row">
        <label>
          {t.contact.name}
          <input type="text" name="name" required autocomplete="name" />
        </label>
        <label>
          {t.contact.email}
          <input type="email" name="email" required autocomplete="email" />
        </label>
      </div>
      <label>
        {t.contact.message}
        <textarea name="message" rows="5" required></textarea>
      </label>
      <button class="btn-primary" type="submit">{t.contact.submit}</button>
    </form>
    <p class="alt muted">
      {t.contact.alt}
      <a href="mailto:mail@valinor.dev.br">mail@valinor.dev.br</a>
    </p>
  </div>
</section>

<style>
  h2 { font-size: 1.875rem; }
  .intro { max-width: 44rem; margin-bottom: 2rem; }
  form { max-width: 44rem; display: flex; flex-direction: column; gap: 1.25rem; }
  .hidden { display: none; }
  .row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.25rem;
  }
  label {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }
  input, textarea {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    color: var(--color-text);
    padding: 0.625rem 0.75rem;
    font: inherit;
  }
  input:focus, textarea:focus {
    outline: none;
    border-color: var(--color-accent);
  }
  button { border: none; cursor: pointer; font: inherit; align-self: flex-start; }
  .alt { margin-top: 1.5rem; font-size: 0.9375rem; }
</style>
