---
import type { Dict } from '../i18n';
interface Props { t: Dict }
const { t } = Astro.props;
---

<section id="product" aria-label={t.product.heading}>
  <div class="container">
    <h2>{t.product.heading}</h2>
    <article class="card product">
      <div>
        <h3><code>I/O Smith</code></h3>
        <p class="muted">{t.product.body}</p>
        <p class="note muted">{t.product.note}</p>
        <a class="btn-secondary" href="https://smithio.valinor.dev.br">{t.product.cta}</a>
      </div>
    </article>
  </div>
</section>

<style>
  h2 { font-size: 1.875rem; }
  .product { max-width: 44rem; padding: 2rem; }
  h3 code { font-size: 1.375rem; color: var(--color-accent); }
  .note { font-size: 0.875rem; font-style: italic; }
  .btn-secondary { margin-top: 0.5rem; }
</style>
